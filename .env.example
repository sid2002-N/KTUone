# KTU One — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Scraper backend
SCRAPER_API_URL=https://your-scraper.on.railway.app
SCRAPER_API_KEY=your-scraper-api-key

# JWT signing
JWT_SECRET=your-64-byte-hex-secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Cached student data TTL (seconds)
CACHE_TTL_SECONDS=86400

# Cron protection
CRON_SECRET=your-cron-secret

# Admin API
ADMIN_API_KEY=your-admin-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Admin CORS
ADMIN_ALLOWED_ORIGIN=https://admin.ktuone.in

# ─────────────────────────────────────────────────────────────────────
# Ads — choose ONE provider via NEXT_PUBLIC_ADS_PROVIDER
#
# Values: "banner" (default, in-house promo CTAs) | "adsense" (web)
#       | "admob" (Capacitor native) | "none" (kill switch)
#
# Leave at "banner" until Google approves your AdSense / AdMob accounts.
# Flip to "adsense" or "admob" + redeploy to activate. No code changes.
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_ADS_PROVIDER=banner

# --- Google AdSense (web only) ---
# Required when NEXT_PUBLIC_ADS_PROVIDER=adsense
# ca-pub-XXXXXXXXXXXXXXXX from your AdSense dashboard
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# JSON map of AdSlot → AdSense slot ID. Slots not in this map render nothing.
# e.g. {"home-top":"1234567890","papers-list":"0987654321","syllabus-list":"..."}
NEXT_PUBLIC_ADSENSE_SLOTS={}
# Optional: "auto" (default) | "horizontal" | "vertical" | "rectangle"
NEXT_PUBLIC_ADSENSE_FORMAT=auto
# Optional: "true" (default) | "false"
NEXT_PUBLIC_ADSENSE_RESPONSIVE=true

# --- Google AdMob (Capacitor native only) ---
# Required when NEXT_PUBLIC_ADS_PROVIDER=admob
# Also requires: npm install @capacitor-community/admob  (after Capacitor setup)
# ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX from AdMob dashboard → App settings
NEXT_PUBLIC_ADMOB_APP_ID=
# Default banner ad unit ID for every active slot
# ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
NEXT_PUBLIC_ADMOB_BANNER_ID=
# Optional JSON map of AdSlot → ad unit ID (overrides default per-slot)
NEXT_PUBLIC_ADMOB_SLOTS={}
# Optional: "SMART_BANNER" (default) | "BANNER" | "LARGE_BANNER" |
#           "MEDIUM_RECTANGLE" | "FULL_BANNER" | "LEADERBOARD"
NEXT_PUBLIC_ADMOB_BANNER_SIZE=SMART_BANNER
# Optional: "TOP_CENTER" | "BOTTOM_CENTER" (default)
NEXT_PUBLIC_ADMOB_POSITION=BOTTOM_CENTER
# Optional JSON array of AdSlots that should reserve layout space
# Default: ["home-top"] — AdMob native banners are typically one banner per screen
NEXT_PUBLIC_ADMOB_ACTIVE_SLOTS=["home-top"]
